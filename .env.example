DEEPSEEK_API_KEY=sk-replace-with-your-key
ANALYTICS_PASSWORD=choose-a-strong-password
# Set to 1 on any host with no display (headless server) so Playwright runs
# headless instead of trying to open a window. The systemd unit already forces
# this in production; only needed for manual `python3 app.py` runs on a server.
# SCRAPER_HEADLESS=1

# Phase 2 fetch-pool size (site fetches run in parallel; the DDG website
# search stays serial regardless — parallel queries trip DDG's rate limit).
# PHASE2_WORKERS=8
